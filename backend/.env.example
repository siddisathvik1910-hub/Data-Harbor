# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (matches docker-compose.yml at the repo root) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dataset_platform?schema=public"

# ---- Auth ----
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d
# Use "none" only if the portals are served from a different registrable domain than the API (requires HTTPS)
COOKIE_SAMESITE=lax

# ---- CORS: the ONLY two origins allowed to call the API ----
ADMIN_ORIGIN=http://localhost:5173
USER_ORIGIN=http://localhost:5174

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_MB=50

# ---- Seed script ----
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="Admin@12345"
# true = also create demo users/datasets so the portals aren't empty
SEED_DEMO=true
